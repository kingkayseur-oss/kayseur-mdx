{
  "name": "kayseur-mdx,
  "version": "2.0.1",
  "description": "Vante-MD WhatsApp Bot with Quantum Mode",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "install:canvas": "npm install canvas --build-from-source",
    "install:all": "npm install && npm run install:canvas",
    "postinstall": "npm run install:canvas || true"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "^6.5.0",
    "axios": "^1.6.0",
    "child_process": "^1.0.2",
    "dotenv": "^16.3.1",
    "form-data": "^4.0.0",
    "moment-timezone": "^0.5.43",
    "net": "^1.0.2",
    "openai": "^4.20.0",
    "os": "^1.0.1",
    "pino": "^8.16.0",
    "play-dl": "^1.9.7",
    "qrcode": "^1.5.3",
    "qrcode-terminal": "^0.12.0",
    "sharp": "^0.33.0",
    "yt-dlp-wrap": "^2.3.11"
  },
  "optionalDependencies": {
    "canvas": "^2.11.2"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "os": [
    "linux",
    "darwin",
    "win32"
  ],
  "cpu": [
    "x64",
    "arm64"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/kingkayseur-oss/kayseur-mdx.git"
  },
  "keywords": [
    "whatsapp",
    "bot",
    "baileys",
    "vantevious",
    "quantum-mode"
  ],
  "author": "ICE WRLD",
  "license": "MIT"
}
